internet_images/
reference_library/
final_prototype/runs/
final_prototype/Digital_train_data/

# Manual backup folders (git history is the backup going forward)
BACKUP_WORKING_*/
production_v2_backup_*/
production_v1/

# Session scratch
_imgserve.py
_verver.py

